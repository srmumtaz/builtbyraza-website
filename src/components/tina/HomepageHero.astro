---
// @ts-nocheck (generated types/client appear after tinacms dev/build runs)
import { tinaField } from '@tinacms/astro/tina-field';
import { sanitizeHref } from '@tinacms/astro/sanitize';
import type { HomepageQuery } from '../../../tina/__generated__/types';

interface Props {
  data?: HomepageQuery['homepage'] | null;
}

const { data } = Astro.props;
---
{
  data && (
    <div class="container">
      <p class="eyebrow" data-tina-field={tinaField(data, 'eyebrow')}>
        {data.eyebrow}
      </p>

      <h1>
        <span data-tina-field={tinaField(data, 'headlineLine1')}>{data.headlineLine1}</span><br />
        <span data-tina-field={tinaField(data, 'headlineLine2')}>{data.headlineLine2}</span><br />
        <span data-tina-field={tinaField(data, 'headlineLine3')}>{data.headlineLine3}</span>
      </h1>

      <p class="hero-text" data-tina-field={tinaField(data, 'introduction')}>
        {data.introduction}
      </p>

      <div class="hero-buttons">
        {data.primaryButton?.label && (
          <a
            class="primary-button"
            href={sanitizeHref(data.primaryButton.href, '#projects')}
            data-tina-field={tinaField(data.primaryButton, 'label')}
          >
            {data.primaryButton.label}
          </a>
        )}
        {data.secondaryButton?.label && (
          <a
            class="secondary-button"
            href={sanitizeHref(data.secondaryButton.href, '#about')}
            data-tina-field={tinaField(data.secondaryButton, 'label')}
          >
            {data.secondaryButton.label}
          </a>
        )}
      </div>
    </div>
  )
}

<style>
  .container {
    width: min(1120px, calc(100% - 40px));
    margin: 0 auto;
  }

  .eyebrow {
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    color: #6b7280;
  }

  h1 {
    max-width: 950px;
    margin: 18px 0 24px;
    font-size: clamp(3rem, 7vw, 6.4rem);
    line-height: 0.98;
    letter-spacing: -0.055em;
  }

  .hero-text {
    max-width: 670px;
    font-size: 1.25rem;
    color: #4b5563;
  }

  .hero-buttons {
    display: flex;
    gap: 14px;
    margin-top: 38px;
  }

  .primary-button,
  .secondary-button {
    padding: 13px 20px;
    border-radius: 8px;
    font-weight: 700;
    text-decoration: none;
  }

  .primary-button {
    background: #111827;
    color: white;
  }

  .secondary-button {
    border: 1px solid #d1d5db;
    color: #111827;
  }

  @media (max-width: 760px) {
    .hero-buttons {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
