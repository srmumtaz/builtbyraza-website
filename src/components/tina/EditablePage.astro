---
// @ts-nocheck (generated types/client appear after tinacms dev/build runs)
import { tinaField } from '@tinacms/astro/tina-field';
import { sanitizeHref } from '@tinacms/astro/sanitize';
import type { SitePageQuery } from '../../../tina/__generated__/types';

interface Props {
  data?: SitePageQuery['sitePage'] | null;
}

const { data } = Astro.props;

const gardeningImageNumbers = [20, ...Array.from({ length: 19 }, (_, index) => index + 1)];

const gardeningImages = gardeningImageNumbers.map((imageNumber) => {
  const title = imageNumber === 20 ? 'Ficus bonsai on my work desk' : undefined;

  return {
    src: `/images/gardening/gallery/garden-${String(imageNumber).padStart(2, '0')}.webp`,
    alt: title ?? `Plant and garden photograph ${imageNumber}`,
    title,
  };
});
---
{
  data && (
    <div class:list={['editable-page', data.styleKey]}>
      <section class="hero">
        <div class="container hero-container">
          <p class="eyebrow" data-tina-field={tinaField(data.hero, 'eyebrow')}>{data.hero.eyebrow}</p>
          <h1 data-tina-field={tinaField(data.hero, 'heading')}>{data.hero.heading}</h1>
          <p class="intro" data-tina-field={tinaField(data.hero, 'introduction')}>{data.hero.introduction}</p>
          {data.hero.meta?.length > 0 && (
            <div class="meta" data-tina-field={tinaField(data.hero, 'meta')}>
              {data.hero.meta.map((entry) => <span>{entry?.text}</span>)}
            </div>
          )}
        </div>
      </section>

      {data.sections?.map((section) => (
        <section class:list={['section', { alt: section?.alternate }]}>
          {section?.layout === 'split' && (
            <div class="container split">
              <div>
                <p class="section-label" data-tina-field={tinaField(section, 'eyebrow')}>{section.eyebrow}</p>
                <h2 data-tina-field={tinaField(section, 'heading')}>{section.heading}</h2>
              </div>
              <div class="copy" data-tina-field={tinaField(section, 'paragraphs')}>
                {section.paragraphs?.map((paragraph) => <p>{paragraph?.text}</p>)}
              </div>
            </div>
          )}

          {section?.layout === 'cards' && (
            <div class="container">
              <div class="section-heading">
                <p class="section-label" data-tina-field={tinaField(section, 'eyebrow')}>{section.eyebrow}</p>
                <h2 data-tina-field={tinaField(section, 'heading')}>{section.heading}</h2>
              </div>
              <div class:list={['cards-grid', section.cardKind ?? 'standard']} data-tina-field={tinaField(section, 'items')}>
                {section.items?.map((item) => (
                  <article class:list={['card', { 'project-card': section.cardKind === 'project', 'roadmap-card': section.cardKind === 'roadmap' }]}>
                    {section.cardKind === 'project' ? (
                      <div class="project-meta"><span>{item?.category}</span>{item?.status && <span>{item.status}</span>}</div>
                    ) : item?.number && <span class="number">{item.number}</span>}
                    <h3>{item?.title}</h3>
                    <p>{item?.description}</p>
                    {item?.href && item?.linkLabel && (
                      <a href={sanitizeHref(item.href, '#')}>{item.linkLabel}</a>
                    )}
                  </article>
                ))}
              </div>
            </div>
          )}

          {section?.layout === 'list' && (
            <div class="container split">
              <div>
                <p class="section-label" data-tina-field={tinaField(section, 'eyebrow')}>{section.eyebrow}</p>
                <h2 data-tina-field={tinaField(section, 'heading')}>{section.heading}</h2>
              </div>
              <div class="learning-list" data-tina-field={tinaField(section, 'items')}>
                {section.items?.map((item) => <div>{item?.text}</div>)}
              </div>
            </div>
          )}

          {section?.layout === 'diagram' && (
            <div class="container">
              <p class="section-label" data-tina-field={tinaField(section, 'eyebrow')}>{section.eyebrow}</p>
              <h2 data-tina-field={tinaField(section, 'heading')}>{section.heading}</h2>
              <div class="diagram-placeholder" data-tina-field={tinaField(section, 'placeholder')}>{section.placeholder}</div>
            </div>
          )}

          {section?.layout === 'status' && (
            <div class="container split">
              <div>
                <p class="section-label" data-tina-field={tinaField(section, 'eyebrow')}>{section.eyebrow}</p>
                <h2 data-tina-field={tinaField(section, 'heading')}>{section.heading}</h2>
              </div>
              <div class="status-box" data-tina-field={tinaField(section, 'items')}>
                {section.items?.map((item) => <><p>{item?.label}</p><strong>{item?.value}</strong></>)}
              </div>
            </div>
          )}
        </section>
      ))}

      {data.styleKey === 'gardening' && (
        <section class="garden-gallery-section" aria-labelledby="garden-gallery-title">
          <div class="container">
            <div class="garden-gallery-heading">
              <div>
                <p class="section-label">FROM MY GARDEN</p>
                <h2 id="garden-gallery-title">A living collection.</h2>
              </div>
              <p>Plants I have grown, collected and cared for—each one part of an ongoing experiment in patience, observation and growth.</p>
            </div>
            <div class="garden-gallery">
              {gardeningImages.map((image, index) => (
                <button class:list={['garden-photo', { wide: index === 4 || index === 13 }]} type="button" data-garden-image={image.src} aria-label={`Enlarge ${image.alt}`}>
                  <img src={image.src} alt={image.alt} loading={index < 4 ? 'eager' : 'lazy'} decoding="async" />
                  <span>{image.title ?? 'View photo'}</span>
                </button>
              ))}
            </div>
          </div>
        </section>
      )}

      {data.styleKey === 'gardening' && (
        <dialog class="garden-lightbox" aria-label="Enlarged garden photograph">
          <button class="garden-lightbox-close" type="button" aria-label="Close enlarged photograph">×</button>
          <img src="" alt="" />
        </dialog>
      )}
    </div>
  )
}

<script>
  const lightbox = document.querySelector<HTMLDialogElement>('.garden-lightbox');
  const lightboxImage = lightbox?.querySelector<HTMLImageElement>('img');
  const closeButton = lightbox?.querySelector<HTMLButtonElement>('.garden-lightbox-close');

  document.querySelectorAll<HTMLButtonElement>('[data-garden-image]').forEach((button) => {
    button.addEventListener('click', () => {
      if (!lightbox || !lightboxImage) return;
      lightboxImage.src = button.dataset.gardenImage ?? '';
      lightboxImage.alt = button.querySelector('img')?.alt ?? 'Garden photograph';
      lightbox.showModal();
    });
  });

  closeButton?.addEventListener('click', () => lightbox?.close());
  lightbox?.addEventListener('click', (event) => {
    if (event.target === lightbox) lightbox.close();
  });
</script>

<style>
  .container { width: min(1120px, calc(100% - 40px)); margin: 0 auto; }
  .hero { padding: 120px 0 110px; }
  .hero-container { max-width: 900px; }
  .eyebrow, .section-label { font-size: 0.78rem; font-weight: 800; letter-spacing: 0.16em; color: #dfa84d; }
  h1 { margin: 18px 0 24px; font-size: clamp(3rem, 6vw, 5.7rem); line-height: 1; letter-spacing: -0.05em; }
  h2 { margin: 8px 0 20px; font-size: clamp(2rem, 4vw, 3.2rem); line-height: 1.08; letter-spacing: -0.035em; }
  h3 { margin: 12px 0 8px; font-size: 1.35rem; }
  .intro { max-width: 760px; font-size: 1.25rem; color: #bcb2a3; }
  .section { padding: 95px 0; }
  .alt { background: #13120f; }
  .split { display: grid; grid-template-columns: 1fr 1fr; gap: 80px; align-items: start; }
  .copy p { margin-top: 0; margin-bottom: 22px; font-size: 1.08rem; color: #bcb2a3; }
  .cards-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; margin-top: 48px; }
  .card { min-height: 250px; padding: 28px; border: 1px solid #49371e; border-radius: 14px; background: #171612; }
  .number { font-size: 0.8rem; font-weight: 800; color: #9ca3af; }
  .card p { color: #aaa091; }
  .learning-list { border-top: 1px solid #49371e; }
  .learning-list div { padding: 20px 0; border-bottom: 1px solid #49371e; font-size: 1.08rem; font-weight: 650; }
  .meta { display: flex; flex-wrap: wrap; gap: 20px; margin-top: 28px; color: #aaa091; font-size: 0.9rem; }
  .diagram-placeholder { min-height: 360px; display: grid; place-items: center; margin-top: 35px; border: 2px dashed #5a4323; border-radius: 16px; color: #aa9b84; background: #171612; }
  .status-box { padding: 30px; border: 1px solid #49371e; border-radius: 14px; background: #171612; }
  .status-box p { margin: 0 0 4px; color: #aaa091; font-size: 0.85rem; }
  .status-box strong { display: block; margin-bottom: 22px; font-size: 1.1rem; }
  .roadmap-card h3 { margin: 14px 0 10px; font-size: 1.3rem; }
  .roadmap-card a { display: inline-block; margin-top: 10px; color: #e9b354; font-weight: 750; text-decoration: none; }
  .roadmap-card a:hover { text-decoration: underline; }
  .project-card { display: flex; flex-direction: column; min-height: 320px; padding: 32px; border-radius: 16px; transition: transform 0.2s ease, box-shadow 0.2s ease; }
  .project-card:hover { transform: translateY(-4px); box-shadow: 0 14px 35px rgba(17, 24, 39, 0.08); }
  .project-meta { display: flex; justify-content: space-between; gap: 20px; margin-bottom: 28px; color: #aa9f8f; font-size: 0.72rem; font-weight: 800; letter-spacing: 0.12em; text-transform: uppercase; }
  .project-card h3 { margin: 0 0 14px; font-size: 1.7rem; line-height: 1.15; letter-spacing: -0.025em; color: #f1eadf; }
  .project-card p { margin: 0 0 30px; line-height: 1.65; }
  .project-card a { margin-top: auto; color: #e9b354; font-weight: 750; text-decoration: none; }
  .project-card a:hover { text-decoration: underline; }

  .garden-gallery-section { padding: 100px 0 120px; background: linear-gradient(180deg, #0f0e0c 0%, #15120d 100%); }
  .garden-gallery-heading { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 70px; align-items: end; margin-bottom: 44px; }
  .garden-gallery-heading h2 { margin-bottom: 0; }
  .garden-gallery-heading > p { max-width: 520px; margin: 0 0 4px; color: #bcb2a3; font-size: 1.05rem; line-height: 1.75; }
  .garden-gallery { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); grid-auto-flow: dense; gap: 14px; }
  .garden-photo { position: relative; min-height: 390px; padding: 0; overflow: hidden; border: 1px solid #49371e; border-radius: 12px; background: #171612; cursor: zoom-in; }
  .garden-photo.wide { grid-column: span 2; }
  .garden-photo img { width: 100%; height: 100%; min-height: 390px; display: block; object-fit: cover; transition: transform .45s ease, filter .45s ease; }
  .garden-photo span { position: absolute; right: 14px; bottom: 14px; padding: 7px 11px; border: 1px solid rgba(231, 170, 71, .55); border-radius: 999px; color: #f6d69e; background: rgba(10, 9, 7, .78); font-size: .7rem; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; opacity: 0; transform: translateY(6px); transition: opacity .25s ease, transform .25s ease; }
  .garden-photo:hover img { transform: scale(1.035); filter: brightness(.78); }
  .garden-photo:hover span, .garden-photo:focus-visible span { opacity: 1; transform: translateY(0); }
  .garden-photo:focus-visible { outline: 2px solid #e7aa47; outline-offset: 3px; }
  .garden-lightbox { width: min(1100px, calc(100% - 32px)); max-width: none; height: min(88vh, 900px); padding: 0; overflow: hidden; border: 1px solid #65491f; border-radius: 16px; background: #0b0a08; box-shadow: 0 28px 90px rgba(0, 0, 0, .72); }
  .garden-lightbox::backdrop { background: rgba(0, 0, 0, .84); backdrop-filter: blur(5px); }
  .garden-lightbox img { width: 100%; height: 100%; display: block; object-fit: contain; }
  .garden-lightbox-close { position: absolute; z-index: 2; top: 14px; right: 14px; width: 42px; height: 42px; border: 1px solid #6a4b20; border-radius: 50%; color: #fff4df; background: rgba(12, 10, 7, .86); font-size: 1.7rem; line-height: 1; cursor: pointer; }

  .story .hero-container { max-width: 850px; }
  .story .split { grid-template-columns: 1.05fr 0.95fr; }
  .story h2 { margin-bottom: 0; }
  .story .intro { max-width: 720px; }
  .projects .hero { padding-bottom: 100px; }
  .projects .hero-container { max-width: none; }
  .projects h1 { max-width: 1000px; font-size: clamp(3rem, 6vw, 5.5rem); }
  .projects .intro { max-width: 700px; font-size: 1.2rem; }
  .projects .section { padding: 90px 0; }
  .projects .section-heading { margin-bottom: 45px; }
  .projects .section-heading h2 { margin-bottom: 0; }
  .projects .cards-grid { gap: 24px; margin-top: 0; }
  .aws-architecture .hero { padding-bottom: 105px; }
  .aws-architecture .cards-grid, .aws-vpc-lab .cards-grid { margin-top: 45px; }
  .aws-architecture h3, .aws-vpc-lab h3 { margin: 14px 0 10px; font-size: 1.3rem; }
  .aws-vpc-lab .hero { padding-bottom: 100px; }
  .aws-vpc-lab h1 { font-size: clamp(3rem, 6vw, 5.5rem); }
  .aws-vpc-lab .intro { font-size: 1.2rem; }

  @media (max-width: 900px) {
    .projects .cards-grid { grid-template-columns: 1fr 1fr; }
    .garden-gallery { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  @media (max-width: 850px) {
    .aws-architecture .split, .aws-architecture .cards-grid,
    .aws-vpc-lab .split, .aws-vpc-lab .cards-grid { grid-template-columns: 1fr; }
    .aws-architecture .split, .aws-vpc-lab .split { gap: 24px; }
  }
  @media (max-width: 760px) {
    .hero { padding: 80px 0; }
    .story .split, .technology .split, .technology .cards-grid { grid-template-columns: 1fr; }
    .story .split, .technology .split { gap: 24px; }
    .garden-gallery-heading { grid-template-columns: 1fr; gap: 18px; }
    .garden-gallery { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .garden-photo, .garden-photo img { min-height: 340px; }
  }
  @media (max-width: 620px) {
    .projects .cards-grid { grid-template-columns: 1fr; }
    .garden-gallery-section { padding: 72px 0 90px; }
    .garden-gallery { grid-template-columns: 1fr; gap: 12px; }
    .garden-photo.wide { grid-column: auto; }
    .garden-photo, .garden-photo img { min-height: 460px; }
  }
</style>
