---
// @ts-nocheck (builder case-study fields are generated by Tina at build time)
import { tinaField } from '@tinacms/astro/tina-field';

const { data } = Astro.props;
const project = data?.builderProject;
---

{data && project && (
  <article class="builder-page">
    <section class="hero">
      <img class="hero-image" src={project.heroImage} alt={project.heroImageAlt} width="1800" height="1200" />
      <div class="hero-shade"></div>
      <div class="container hero-copy">
        <p class="eyebrow" data-tina-field={tinaField(data.hero, 'eyebrow')}>{data.hero.eyebrow}</p>
        <h1 data-tina-field={tinaField(data.hero, 'heading')}>{data.hero.heading}</h1>
        <p class="intro" data-tina-field={tinaField(data.hero, 'introduction')}>{data.hero.introduction}</p>
        <div class="hero-meta">
          <span data-tina-field={tinaField(project, 'locationLabel')}>{project.locationLabel}</span>
          <span data-tina-field={tinaField(project, 'period')}>{project.period}</span>
        </div>
      </div>
    </section>

    <section class="project-intro">
      <div class="container intro-grid">
        <div><p class="section-label">THE OPPORTUNITY</p><h2 data-tina-field={tinaField(project, 'overviewTitle')}>{project.overviewTitle}</h2></div>
        <div class="story-copy" data-tina-field={tinaField(project, 'overviewParagraphs')}>
          {project.overviewParagraphs?.map((paragraph) => <p>{paragraph?.text}</p>)}
        </div>
      </div>
    </section>

    <section class="metrics-section">
      <div class="container metrics" data-tina-field={tinaField(project, 'metrics')}>
        {project.metrics?.map((metric) => <div class="metric"><strong>{metric?.value}</strong><span>{metric?.label}</span><small>{metric?.detail}</small></div>)}
      </div>
    </section>

    <section class="scope-section">
      <div class="container">
        <p class="section-label">THE BUILD</p><h2>One house. A complete rethink.</h2>
        <div class="scope-grid" data-tina-field={tinaField(project, 'transformations')}>
          {project.transformations?.map((item, index) => <article class="scope-card"><span>{String(index + 1).padStart(2, '0')}</span><h3>{item?.title}</h3><p>{item?.description}</p></article>)}
        </div>
      </div>
    </section>

    <section class="comparisons-section">
      <div class="container section-heading"><p class="section-label">BEFORE / AFTER</p><h2>Transformation, room by room.</h2><p>Drag each divider to reveal the change.</p></div>
      <div class="container comparisons" data-tina-field={tinaField(project, 'comparisons')}>
        {project.comparisons?.map((comparison) => (
          <article class="comparison-card">
            <div class="comparison-heading"><h3>{comparison?.title}</h3><p>{comparison?.caption}</p></div>
            <div class="before-after" style="--position: 50%">
              <img class="after-image" src={comparison?.afterImage} alt={comparison?.afterAlt} loading="lazy" />
              <div class="before-layer"><img src={comparison?.beforeImage} alt={comparison?.beforeAlt} loading="lazy" /></div>
              <span class="image-label before-label">BEFORE</span><span class="image-label after-label">AFTER</span>
              <div class="divider" aria-hidden="true"><span>↔</span></div>
              <input class="comparison-slider" type="range" min="0" max="100" value="50" aria-label={`Compare before and after: ${comparison?.title}`} />
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="closing-section">
      <div class="container closing-grid"><p class="section-label">WHAT IT BUILT IN ME</p><div><h2 data-tina-field={tinaField(project, 'closingHeading')}>{project.closingHeading}</h2><p data-tina-field={tinaField(project, 'closingText')}>{project.closingText}</p></div></div>
    </section>
  </article>
)}

<script>
  document.querySelectorAll<HTMLElement>('.before-after').forEach((comparison) => {
    const slider = comparison.querySelector<HTMLInputElement>('.comparison-slider');
    slider?.addEventListener('input', () => comparison.style.setProperty('--position', `${slider.value}%`));
  });
</script>

<style>
  .builder-page { background: #0b0b0a; color: #f1eadf; }
  .container { width: min(1180px, calc(100% - 40px)); margin: 0 auto; }
  .hero { position: relative; min-height: min(820px, calc(100vh - 73px)); display: flex; align-items: end; overflow: hidden; }
  .hero-image, .hero-shade { position: absolute; inset: 0; width: 100%; height: 100%; }
  .hero-image { object-fit: cover; object-position: center; }
  .hero-shade { background: linear-gradient(90deg, rgba(7,7,6,.96) 0%, rgba(7,7,6,.72) 43%, rgba(7,7,6,.18) 78%), linear-gradient(0deg, #0b0b0a 0%, transparent 38%); }
  .hero-copy { position: relative; z-index: 1; padding-top: 150px; padding-bottom: 90px; }
  .eyebrow, .section-label { margin: 0; color: #e7aa47; font-size: .75rem; font-weight: 850; letter-spacing: .2em; }
  h1 { max-width: 900px; margin: 18px 0 24px; font-size: clamp(3.5rem, 8vw, 7.5rem); line-height: .92; letter-spacing: -.06em; }
  h2 { margin: 14px 0 24px; font-size: clamp(2.35rem, 5vw, 4.5rem); line-height: 1; letter-spacing: -.045em; }
  h3 { margin: 0; font-size: 1.5rem; line-height: 1.15; }
  .intro { max-width: 660px; margin: 0; color: #d0c6b6; font-size: clamp(1.05rem, 2vw, 1.35rem); }
  .hero-meta { display: flex; gap: 12px; margin-top: 34px; }
  .hero-meta span { padding: 8px 12px; border: 1px solid #6d4d24; border-radius: 999px; color: #e7aa47; background: rgba(12,12,10,.72); font-size: .75rem; font-weight: 800; letter-spacing: .08em; }
  .project-intro, .scope-section, .comparisons-section, .closing-section { padding: 110px 0; }
  .intro-grid, .closing-grid { display: grid; grid-template-columns: .85fr 1.15fr; gap: 90px; }
  .story-copy p, .closing-grid p { margin: 0 0 22px; color: #bcb2a3; font-size: 1.1rem; }
  .metrics-section { border-top: 1px solid #332716; border-bottom: 1px solid #332716; background: #12110e; }
  .metrics { display: grid; grid-template-columns: repeat(4, 1fr); }
  .metric { min-height: 210px; display: flex; flex-direction: column; justify-content: center; padding: 34px; border-right: 1px solid #332716; }
  .metric:last-child { border-right: 0; }
  .metric strong { color: #e7aa47; font-size: clamp(2.2rem, 4vw, 3.5rem); line-height: 1; }
  .metric span { margin-top: 12px; font-weight: 800; }
  .metric small { margin-top: 7px; color: #8f8576; }
  .scope-section { background: #0f0e0c; }
  .scope-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; margin-top: 50px; }
  .scope-card { min-height: 260px; padding: 30px; border: 1px solid #3e2f1a; border-radius: 14px; background: linear-gradient(145deg, #191712, #11100d); }
  .scope-card > span { color: #a77a36; font-size: .72rem; font-weight: 900; letter-spacing: .15em; }
  .scope-card h3 { margin: 40px 0 12px; }
  .scope-card p { margin: 0; color: #a99f90; }
  .section-heading { margin-bottom: 55px; }
  .section-heading > p:last-child { color: #9c9284; }
  .comparisons { display: grid; gap: 80px; }
  .comparison-card { display: grid; grid-template-columns: 260px 1fr; gap: 36px; align-items: start; }
  .comparison-heading { padding-top: 12px; }
  .comparison-heading p { color: #9e9486; }
  .before-after { --position: 50%; position: relative; aspect-ratio: 16 / 9; overflow: hidden; border: 1px solid #4b371d; border-radius: 16px; background: #17140f; box-shadow: 0 24px 70px rgba(0,0,0,.28); }
  .before-after img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .after-image { position: absolute; inset: 0; }
  .before-layer { position: absolute; inset: 0 auto 0 0; width: var(--position); overflow: hidden; }
  .before-layer img { width: calc(100vw - 336px); max-width: 884px; }
  .divider { position: absolute; top: 0; bottom: 0; left: var(--position); width: 3px; transform: translateX(-50%); background: #f1b552; pointer-events: none; }
  .divider span { position: absolute; top: 50%; left: 50%; display: grid; width: 46px; height: 46px; place-items: center; transform: translate(-50%,-50%); border: 2px solid #f1b552; border-radius: 50%; color: #16110a; background: #f1b552; font-weight: 900; box-shadow: 0 4px 20px rgba(0,0,0,.4); }
  .comparison-slider { position: absolute; inset: 0; width: 100%; height: 100%; margin: 0; opacity: 0; cursor: ew-resize; }
  .image-label { position: absolute; top: 18px; padding: 7px 10px; border-radius: 4px; color: #fff; background: rgba(9,9,8,.8); font-size: .68rem; font-weight: 900; letter-spacing: .13em; pointer-events: none; }
  .before-label { left: 18px; }
  .after-label { right: 18px; }
  .closing-section { border-top: 1px solid #332716; background: #12110e; }
  .closing-grid h2 { margin-top: 0; }
  @media (max-width: 900px) {
    .metrics { grid-template-columns: 1fr 1fr; }
    .metric:nth-child(2) { border-right: 0; }
    .metric:nth-child(-n+2) { border-bottom: 1px solid #332716; }
    .scope-grid { grid-template-columns: 1fr 1fr; }
    .comparison-card { grid-template-columns: 1fr; gap: 18px; }
    .before-layer img { width: calc(100vw - 40px); max-width: none; }
  }
  @media (max-width: 700px) {
    .hero { min-height: 690px; }
    .hero-shade { background: linear-gradient(0deg, rgba(7,7,6,.97) 0%, rgba(7,7,6,.55) 65%, rgba(7,7,6,.2) 100%); }
    .hero-copy { padding-bottom: 62px; }
    .project-intro, .scope-section, .comparisons-section, .closing-section { padding: 78px 0; }
    .intro-grid, .closing-grid, .scope-grid { grid-template-columns: 1fr; gap: 26px; }
    .comparison-card { gap: 12px; }
    .before-after { aspect-ratio: 4 / 3; border-radius: 10px; }
  }
</style>
