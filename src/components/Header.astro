---
// @ts-nocheck (generated types/client appear after tinacms dev/build runs)
import { tinaField } from '@tinacms/astro/tina-field';
import { sanitizeHref } from '@tinacms/astro/sanitize';
import type { SiteSettingsQuery } from '../../tina/__generated__/types';

interface Props {
  data?: SiteSettingsQuery['siteSettings'] | null;
}

const { data } = Astro.props;
const pathname = Astro.url.pathname;
const isActive = (href?: string | null) => {
  if (!href) return false;
  if (href === '/projects') return pathname.startsWith('/projects');
  return pathname === href;
};
---

<header class="site-header">
  <div class="container nav">
    <a class="logo" href="/" data-tina-field={data && tinaField(data, 'brand')}>{data?.brand}</a>

    <button
      class="menu-button"
      type="button"
      aria-label="Open navigation menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span></span>
      <span></span>
      <span></span>
    </button>

    <nav class="desktop-nav" data-tina-field={data && tinaField(data, 'navigation')}>
      {data?.navigation?.map((item) => (
        <a class:list={{ active: isActive(item?.href) }} href={sanitizeHref(item?.href, '/')}>{item?.label}</a>
      ))}
    </nav>
  </div>

  <nav id="mobile-menu" class="mobile-nav" data-tina-field={data && tinaField(data, 'navigation')}>
    {data?.navigation?.map((item) => (
      <a href={sanitizeHref(item?.href, '/')}>{item?.label}</a>
    ))}
  </nav>
</header>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const menuButton = document.querySelector<HTMLButtonElement>(".menu-button");
    const mobileMenu = document.querySelector<HTMLElement>(".mobile-nav");

    if (!menuButton || !mobileMenu) {
      console.log("Mobile menu elements not found");
      return;
    }

    menuButton.addEventListener("click", () => {
      mobileMenu.classList.toggle("open");

      const isOpen = mobileMenu.classList.contains("open");

      menuButton.setAttribute(
        "aria-expanded",
        isOpen ? "true" : "false"
      );
    });
  });
</script>
<style>
  .container {
    width: min(1440px, calc(100% - 40px));
    margin: 0 auto;
  }

  .site-header {
    border-bottom: 1px solid #3a2b17;
    background: rgba(14, 14, 13, 0.96);
    position: sticky;
    top: 0;
    z-index: 10;
  }

  .nav {
    min-height: 72px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .logo {
    color: #e9b354;
    font-size: 1.1rem;
    font-weight: 800;
    text-decoration: none;
  }

  .desktop-nav {
    display: flex;
    gap: 18px;
  }

  .desktop-nav a,
  .mobile-nav a {
    color: #c7bdaa;
    text-decoration: none;
    font-size: 0.8rem;
  }

  .desktop-nav a:hover,
  .mobile-nav a:hover {
    color: #e9b354;
  }

  .desktop-nav a.active {
    color: #e9b354;
    font-weight: 700;
  }

  .menu-button {
    display: none;
    width: 42px;
    height: 42px;
    border: 0;
    background: transparent;
    cursor: pointer;
    padding: 8px;
  }

  .menu-button span {
    display: block;
    height: 2px;
    background: #e9b354;
    margin: 5px 0;
  }

  .mobile-nav {
    display: none;
    padding: 10px 20px 24px;
    border-top: 1px solid #3a2b17;
    background: #11110f;
  }

  .mobile-nav.open {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  @media (max-width: 760px) {
    .desktop-nav {
      display: none;
    }

    .menu-button {
      display: block;
    }
  }
</style>
