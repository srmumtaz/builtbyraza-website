---
// @ts-nocheck (generated types/client appear after tinacms dev/build runs)
import { tinaField } from '@tinacms/astro/tina-field';
import type { SiteSettingsQuery } from '../../tina/__generated__/types';

interface Props {
  data?: SiteSettingsQuery['siteSettings'] | null;
}

const { data } = Astro.props;
---
<footer>
  <div class="container footer-content">
    <div>
      <strong data-tina-field={data && tinaField(data, 'brand')}>{data?.brand}</strong>
      <p data-tina-field={data && tinaField(data, 'footerTagline')}>{data?.footerTagline}</p>
    </div>

    <p data-tina-field={data && tinaField(data, 'footerCredit')}>{data?.footerCredit}</p>
  </div>
</footer>

<style>
  .container {
    width: min(1120px, calc(100% - 40px));
    margin: 0 auto;
  }

  footer {
    padding: 55px 0;
    border-top: 1px solid #3a2b17;
    background: #080807;
    color: #f1eadf;
  }

  .footer-content {
    display: flex;
    justify-content: space-between;
    align-items: end;
  }

  footer p {
    color: #a99f90;
    margin-bottom: 0;
  }

  @media (max-width: 760px) {
    .footer-content {
      display: block;
    }
  }
</style>
