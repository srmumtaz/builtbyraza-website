---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import TinaIsland from '@tinacms/astro/TinaIsland.astro';
import { getSiteSettings } from '../lib/tina/data';
import { islands } from '../lib/tina/islands';
import localSettings from '../../content/settings/site.json';

interface Props {
  title: string;
  description?: string;
  hideChrome?: boolean;
}

const {
  title,
  description = "Built By Raza — solutions architecture, technology, learning and things I build.",
  hideChrome = false,
} = Astro.props;

let settings = localSettings;
try {
  const settingsResult = await getSiteSettings();
  settings = settingsResult.data?.siteSettings ?? settings;
} catch {}
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />

    <title>{title}</title>
  </head>

  <body>
    {!hideChrome && (
      <TinaIsland name="siteHeader" wrapper={islands.siteHeader.wrapper}>
        <Header data={settings} />
      </TinaIsland>
    )}

    <main>
      <slot />
    </main>

    {!hideChrome && (
      <TinaIsland name="siteFooter" wrapper={islands.siteFooter.wrapper}>
        <Footer data={settings} />
      </TinaIsland>
    )}
  </body>
</html>

<style is:global>
  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    font-family:
      Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
      "Segoe UI", sans-serif;
    color: #f1eadf;
    background: #0b0b0a;
    line-height: 1.65;
  }

  .container {
    width: min(1120px, calc(100% - 40px));
    margin: 0 auto;
  }
</style>
